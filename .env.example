# Copy to .env (untracked) and fill in. In CI, set these as pipeline variables/secrets instead.

# Base URL of the site under test (UI). Defaults to a local dev server: http://localhost:3000
# BASE_URL=

# Base URL of the API under test. Defaults to a local dev server: http://localhost:8888
# API_BASE_URL=

# Password shared by the saucedemo test accounts (standard_user, problem_user, …)
SAUCE_PASSWORD=

# A dummyjson account for the API tests (dummyjson only accepts its own users)
API_USERNAME=
API_PASSWORD=

# Optional
# LOCALE=en-US
